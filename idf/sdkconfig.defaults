CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 240 MHz. The control loop is small; the radio is what this buys.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 2 ms waits must be real. At the default 100 Hz tick, pdMS_TO_TICKS(2) is 0
# and the control task would spin.
CONFIG_FREERTOS_HZ=1000

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Keep the Wi-Fi RX path in IRAM so a flash fetch does not stall a command frame.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Aggregation holds small frames until a burst fills. Drive frames are 12 bytes.
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set

# Duty updates and enable pins stay runnable while the radio touches flash.
CONFIG_LEDC_CTRL_FUNC_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
